{
  "$schema": "https://schema.tauri.app/config/2.1",
  "productName": "OverlayTrans",
  "version": "3.0.4",
  "identifier": "com.overlaytrans.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "capture",
        "title": "OverlayTrans - Capture",
        "url": "/#/capture",
        "width": 640,
        "height": 160,
        "x": 200,
        "y": 200,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false
      },
      {
        "label": "translation",
        "title": "OverlayTrans",
        "url": "/#/translation",
        "width": 720,
        "height": 220,
        "x": 180,
        "y": 380,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false
      },
      {
        "label": "settings",
        "title": "OverlayTrans - Settings",
        "url": "/#/settings",
        "width": 720,
        "height": 600,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": false,
        "visible": false
      },
      {
        "label": "onboarding",
        "title": "OverlayTrans - Welcome",
        "url": "/#/onboarding",
        "width": 680,
        "height": 480,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header-nsis.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp"
      },
      "wix": {
        "bannerPath": "icons/installer-header.bmp",
        "dialogImagePath": "icons/installer-dialog.bmp"
      }
    },
    "externalBin": ["binaries/llama-server"],
    "resources": {
      "icons/icon.ico": "OverlayTrans-3.0.4.ico",
      "binaries/*.dll": "",
      "binaries/llama-server-LICENSE.txt": ""
    }
  },
  "plugins": {
    "global-shortcut": null
  }
}
