# Check out every text file with LF on all platforms, Windows included: the license
# gate compares the tracked reports byte for byte with freshly generated LF output,
# and Vite cannot load a CRLF script that starts with a shebang.
* text=auto eol=lf

# Binary files — no line-ending conversion
*.png     binary
*.jpg     binary
*.bmp     binary
*.ico     binary
*.icns    binary
*.zip     binary
*.dll     binary
*.exe     binary
