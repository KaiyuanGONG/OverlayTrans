# Normalize line endings on checkout to LF for all text files
* text=auto

# Source files — always LF
*.rs      text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.toml    text eol=lf
*.md      text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf

# Binary files — no line-ending conversion
*.png     binary
*.jpg     binary
*.ico     binary
*.icns    binary
*.onnx    binary
*.zip     binary
*.dll     binary
*.exe     binary
